generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                  @id @default(autoincrement())
  googleId             String               @unique
  email                String               @unique
  name                 String
  avatarUrl            String?
  messages             Message[]
  reactions            MessageReaction[]
  messagePins          MessagePin[]
  notifications        Notification[]       @relation("NotificationRecipient")
  notificationsCreated Notification[]       @relation("NotificationActor")
  memberships          ConversationMember[]
  createdAt            DateTime             @default(now())
}

model Conversation {
  id            Int                  @id @default(autoincrement())
  name          String
  messages      Message[]
  members       ConversationMember[]
  notifications Notification[]
  createdAt     DateTime             @default(now())
}

model ConversationMember {
  userId             Int
  conversationId     Int
  lastReadMessageId  Int?
  role               MembershipRole @default(MEMBER)
  notificationsMuted Boolean        @default(false)
  archivedAt         DateTime?

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  joinedAt DateTime @default(now())

  @@id([userId, conversationId])
  @@index([userId, archivedAt])
}

enum MembershipRole {
  ADMIN
  MEMBER
}

model Message {
  id   Int    @id @default(autoincrement())
  text String

  senderId Int
  sender   User @relation(fields: [senderId], references: [id])

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  replyToMessageId Int?
  replyToMessage   Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies          Message[]         @relation("MessageReplies")
  reactions        MessageReaction[]
  pins             MessagePin[]
  notifications    Notification[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, id])
  @@index([replyToMessageId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  userId    Int
  messageId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessagePin {
  id         Int      @id @default(autoincrement())
  messageId  Int      @unique
  pinnedById Int
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy   User     @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([pinnedById])
}

model Notification {
  id             Int          @id @default(autoincrement())
  userId         Int
  actorId        Int
  conversationId Int
  messageId      Int
  user           User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, messageId])
  @@index([userId, readAt, id])
}
