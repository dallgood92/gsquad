generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                  @id @default(autoincrement())
  googleId             String               @unique
  email                String               @unique
  name                 String
  avatarUrl            String?
  messages             Message[]
  reactions            MessageReaction[]
  messagePins          MessagePin[]
  notifications        Notification[]       @relation("NotificationRecipient")
  notificationsCreated Notification[]       @relation("NotificationActor")
  memberships          ConversationMember[]
  friendships          Friendship[]         @relation("FriendshipOwner")
  friendedBy           Friendship[]         @relation("FriendshipFriend")
  createdConversations Conversation[]       @relation("ConversationCreator")
  blockedUsers         UserBlock[]          @relation("BlockOwner")
  blockedBy            UserBlock[]          @relation("BlockedUser")
  createdAt            DateTime             @default(now())
}

model UserBlock {
  blockerId Int
  blockedId Int
  blocker   User     @relation("BlockOwner", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Friendship {
  userId    Int
  friendId  Int
  user      User     @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  status    FriendshipStatus @default(PENDING)

  @@id([userId, friendId])
  @@index([friendId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Conversation {
  id            Int                  @id @default(autoincrement())
  name          String
  type          ConversationType     @default(GROUP)
  directKey     String?              @unique
  createdById   Int?
  createdBy     User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages      Message[]
  members       ConversationMember[]
  notifications Notification[]
  createdAt     DateTime             @default(now())

  @@index([createdById])
}

enum ConversationType {
  GROUP
  DIRECT
}

model ConversationMember {
  userId             Int
  conversationId     Int
  lastReadMessageId  Int?
  role               MembershipRole @default(MEMBER)
  notificationsMuted Boolean        @default(false)
  archivedAt         DateTime?

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  joinedAt DateTime @default(now())

  @@id([userId, conversationId])
  @@index([userId, archivedAt])
}

enum MembershipRole {
  ADMIN
  MEMBER
}

model Message {
  id   Int    @id @default(autoincrement())
  text String

  senderId Int
  sender   User @relation(fields: [senderId], references: [id])

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  replyToMessageId Int?
  replyToMessage   Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies          Message[]         @relation("MessageReplies")
  reactions        MessageReaction[]
  pins             MessagePin[]
  notifications    Notification[]
  attachments      MessageAttachment[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, id])
  @@index([replyToMessageId])
}

model MessageAttachment {
  id           Int      @id @default(autoincrement())
  messageId    Int
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  duration     Float?
  createdAt    DateTime @default(now())

  @@index([messageId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  userId    Int
  messageId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessagePin {
  id         Int      @id @default(autoincrement())
  messageId  Int      @unique
  pinnedById Int
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy   User     @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([pinnedById])
}

model Notification {
  id             Int          @id @default(autoincrement())
  type           NotificationType @default(MENTION)
  userId         Int
  actorId        Int
  conversationId Int?
  messageId      Int?
  user           User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, messageId])
  @@index([userId, readAt, id])
}

enum NotificationType {
  MENTION
  FRIEND_ACCEPTED
}
